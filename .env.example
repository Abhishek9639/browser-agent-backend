# Copy to .env and adjust. Never commit .env.
# Every setting in app/core/config.py is mirrored here. Keep the two in sync.

# --- application ---
APP_NAME=browser-agent-backend
APP_ENV=dev                          # dev | test | prod
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Comma-separated. Spec section 10: restrict to the frontend origin.
MAX_REQUEST_BYTES=1048576
HSTS_MAX_AGE_SECONDS=63072000
CORS_ORIGINS=http://localhost:3000

# --- rate limits (spec section 10) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_TASK_CREATE_PER_MINUTE=10
RATE_LIMIT_APPROVAL_PER_MINUTE=20
RATE_LIMIT_STREAM_TICKET_PER_MINUTE=30
# Only enable behind a proxy you control; clients can forge this header.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- database ---
# docker compose and the app both read these, so the container credentials and
# the app's DSN cannot drift apart.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres         # secret
POSTGRES_HOST=localhost
# If 5432 is already taken on your machine (a Homebrew or Postgres.app install
# binds 127.0.0.1 and shadows Docker), set this to a free port such as 5433.
# compose publishes on it and the app connects to it.
POSTGRES_PORT=5432
POSTGRES_DB=agent_core
POSTGRES_TEST_DB=agent_core_test   # integration tests only; never the live db
# Leave blank to assemble the DSN from the values above. Set it to point at a
# managed instance instead.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_HEALTHCHECK_TIMEOUT_SECONDS=2.0

# --- jwt ---
# Generate the keypair with: python scripts/gen_keys.py
# keys/ is gitignored. Never commit the private key.
JWT_ALGORITHM=RS256
JWT_ISSUER=browser-agent-backend
JWT_AUDIENCE=browser-agent
JWT_KID=browser-agent-key-1
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_TTL_MIN=15              # spec section 2
REFRESH_TOKEN_TTL_DAYS=7             # spec section 2
REFRESH_REUSE_GRACE_SECONDS=10       # 0 = any reuse destroys the session chain
JWT_REFRESH_COOKIE_NAME=refresh_token

# --- llm (B23, B24) ---
LLM_PROVIDER=mock                    # mock | anthropic | openai | gemini | groq
LLM_FALLBACK_PROVIDER=               # used if the primary is unreachable; blank disables
GEMINI_REQUESTS_PER_MINUTE=0         # free tier is 5; 0 = do not pace
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite   # tried when LLM_MODEL is used up
GROQ_REQUESTS_PER_MINUTE=0           # 0 = do not pace
# Optional. Leave blank and each provider picks its own default, so switching
# provider does not also mean looking up that vendor's model names:
#   anthropic -> claude-sonnet-5    openai -> gpt-6-luna    gemini -> gemini-3.6-flash
# Set it to pin one. Note it applies to whichever provider is selected, so a
# value pinned for one vendor will be sent to another if you switch.
LLM_MODEL=                           # e.g. gemini-3.6-flash
LLM_VISION_MODEL=                    # falls back to LLM_MODEL when blank
# One key per provider; only the selected provider's key is required.
ANTHROPIC_API_KEY=                   # secret
OPENAI_API_KEY=                      # secret
GOOGLE_API_KEY=                      # secret
GROQ_API_KEY=                        # secret
GROQ_MODEL=                          # default openai/gpt-oss-120b
GROQ_VISION_MODEL=                   # default qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b   # tried in order when GROQ_MODEL is rate limited
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
PLANNER_PROMPT_VERSION=v2

# --- agent budgets (spec section 4.2) ---
AGENT_MAX_STEPS=25
AGENT_MAX_TASK_SECONDS=300
AGENT_MAX_RETRIES_PER_STEP=3
AGENT_MAX_TABS=5
CACHE_ENABLED=true
CACHE_MIN_SUCCESS_RATE=0.5
# Presented by the Prometheus scraper as X-Internal-Token. Leave unset to
# allow only an ADMIN bearer token.
METRICS_INTERNAL_TOKEN=
AGENT_APPROVAL_TIMEOUT_SECONDS=600
AGENT_MAX_CONCURRENT_TASKS=3
AGENT_MAX_CONCURRENT_TASKS_PER_USER=2
AGENT_DOM_TOKEN_BUDGET=3000
AGENT_HEADLESS=true
AGENT_LOGIN_WAIT_SECONDS=900       # how long to wait for you to sign in or sign up (not counted against the task time limit)
AGENT_PAYMENT_WAIT_SECONDS=900     # how long to wait for you to pay; the agent books up to payment and never pays itself
AGENT_FULLSCREEN=false               # true = maximised window; the page fills it (visible browser only)
AGENT_CLARIFY=false                # true = ask you a few questions first (time, class, budget...), and again on each page it opens about what that page's form needs (one way/round trip...)
AGENT_CLARIFY_MAX_QUESTIONS=3
AGENT_CLARIFY_WAIT_SECONDS=600     # how long to wait for each answer (not counted against the task time limit)
AGENT_PLAN_PREVIEW=false           # true = outline the expected steps once the site is open and its questions answered (one extra model call)
AGENT_BROWSER_FALLBACKS=msedge,firefox   # tried in turn when a site refuses the agent's browser (403); empty = off
AGENT_BROWSER_CHANNEL=            # empty = bundled Chromium; chrome | msedge = installed browser
AGENT_SLOW_MO_MS=0
# Empty = isolated Chromium. Set e.g. http://127.0.0.1:9222 to drive your own Chrome.
AGENT_CDP_URL=
# Spec section 4.7: verification waits for the page to stop changing, so a
# click that triggers a fetch is not checked before the response lands.
AGENT_SETTLE_QUIET_MS=300
# Spec section 4.10. Comma-separated; empty uses the built-in phrase list.
RISK_HIGH_PHRASES=
# Whether a task's own submitter may approve its high-risk steps.
APPROVAL_OWNER_CAN_APPROVE=true
# Spec section 4.9: when a picture is worth taking, and how big it may be.
VISION_PROMPT_VERSION=v1
VISION_MAX_WIDTH=1024
VISION_CONFIDENCE_THRESHOLD=0.6
VISION_MIN_ELEMENTS=5
VISION_MAX_IMAGE_BYTES=1500000

# Spec section 9 cost per task. Rupees per million tokens; set these to your
# provider's actual prices before reading any cost number as money.
LLM_PRICE_INPUT_PER_MTOK=25.0
LLM_PRICE_OUTPUT_PER_MTOK=100.0
LLM_PRICE_CURRENCY=INR
AGENT_SETTLE_TIMEOUT_MS=3000
# Comma-separated. Spec section 4.13: demo sites plus permitted practice sites.
# A bare host matches any port; add a port to pin one.
AGENT_ALLOWED_DOMAINS=localhost,127.0.0.1,localhost:8200,127.0.0.1:8200

# ---------------------------------------------------------------- live view
# Stream tickets travel in a WebSocket URL, which is the one place an access
# token must never go, so they are short-lived and good for one connection.
WS_TICKET_TTL_SECONDS=60
WS_HEARTBEAT_SECONDS=15

# --- browser (B08) ---
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_NAVIGATION_TIMEOUT_MS=30000

# --- screenshots (spec section 6.1) ---
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_JPEG_QUALITY=60

# --- billing (B12, B30) ---
BILLING_ENABLED=false
PAYMENTS_BASE_URL=http://localhost:8100
INTERNAL_API_TOKEN=                  # secret, shared with the payments service
PAYMENTS_TIMEOUT_SECONDS=3.0
PAYMENTS_MAX_ATTEMPTS=3
# Spec section 7 pricing. The payments service holds the same figures.
CREDITS_PER_STEP=1
CREDITS_PER_VISION_STEP=2
CREDITS_REPLAY_STEP_HALF=true
RESERVE_MULTIPLIER=2
BILLING_OUTBOX_POLL_SECONDS=5.0
BILLING_OUTBOX_BACKOFF_SECONDS=10.0
BILLING_OUTBOX_MAX_ATTEMPTS=12

# --- storage (B15) ---
STORAGE_BACKEND=local                # local | s3
STORAGE_DIR=storage
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY=               # secret
STORAGE_S3_SECRET_KEY=               # secret
