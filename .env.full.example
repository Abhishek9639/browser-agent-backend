# Configuration for the full stack in deploy/docker-compose.full.yml.
#
#   cd deploy && cp ../.env.full.example .env
#
# Every value below is either a safe default or blank. A blank secret is
# deliberate: the stack starts without it, and the service that needs it says so
# loudly rather than running with a placeholder that looks configured.
#
# This is a development file. Nothing here belongs in a deployment.

# ----------------------------------------------------------------- general
APP_ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------- postgres
# One server, three databases. Published on 5433 because a developer running
# this usually has something on 5432 already.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_core
PAYMENTS_DB=payments
POSTGRES_PORT=5433

# --------------------------------------------------------------- the ports
API_PORT=8000
FRONTEND_PORT=3000
PAYMENTS_PORT=8100

# ----------------------------------------------------------------- the API
CORS_ORIGINS=http://localhost:3000
# The sites the agent may visit, comma-separated. `*` allows any site.
AGENT_ALLOWED_DOMAINS=localhost,127.0.0.1
# Protects GET /metrics, which is otherwise ADMIN-only. Leave blank and use an
# admin token instead if you prefer.
METRICS_INTERNAL_TOKEN=

# ----------------------------------------------------------------- the LLM
# `mock` is rule-based, offline and free: the whole stack demonstrates itself
# without an API key. Switch to anthropic, openai or gemini and set the matching
# key to use a real model.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------ the payments
# Leave BILLING_ENABLED=false until the payments service is running. Enabled
# with nothing to call means every task submission answers 503.
BILLING_ENABLED=false
PAYMENTS_BASE_URL=http://payments:8100
# Shared secret between the backend and payments. Generate one with
# `openssl rand -hex 32`; both services read this same variable.
INTERNAL_API_TOKEN=
# Razorpay TEST mode only (spec section 7).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JWKS_URL=http://api:8000/.well-known/jwks.json

# ------------------------------------------------------------ the frontend
# Read by the browser, so these are host addresses rather than service names.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
